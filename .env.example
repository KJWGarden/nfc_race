# CHECKPOINT 환경 변수 템플릿. 실제 값은 .env.local (로컬) 또는 Vercel 환경 변수에만 넣는다.
# NEXT_PUBLIC_ 이 붙은 값만 브라우저로 나간다. 나머지는 모두 서버 전용이며 절대 NEXT_PUBLIC_ 으로 옮기지 않는다.

# --- 서버 전용 ---

# Supabase API URL. 로컬: `supabase status -o env` 의 API_URL (http://127.0.0.1:55421) / 운영: 대시보드 Project Settings → API
SUPABASE_URL=
# service_role 키 (RLS 우회, DB 전체 권한). 로컬: SERVICE_ROLE_KEY / 운영: 대시보드 API 설정의 service_role
SUPABASE_SERVICE_ROLE_KEY=
# 관리자 Realtime 토큰 서명용 JWT secret. 로컬: JWT_SECRET / 운영: 대시보드 JWT 설정의 JWT secret
SUPABASE_JWT_SECRET=
# 쿠키 서명 비밀값. 운영에서 비었거나 기본값이면 모든 API 가 503. 생성: openssl rand -hex 32
APP_SECRET=
# 관리자 비밀번호. 운영에서 비었거나 기본값(admin123)이면 모든 API 가 503
ADMIN_PASSWORD=
# NTAG 424 DNA SDM 메타 읽기 키 (32 hex). 생성: openssl rand -hex 16
SUN_META_KEY=
# NTAG 424 DNA 파일 읽기 키 마스터 (32 hex). 태그별 키가 여기서 파생된다. 유출 시 태그 위조 가능. 생성: openssl rand -hex 16
SUN_MASTER_KEY=

# --- 브라우저 공개 (빌드 시점에 번들에 고정됨. 바꾸면 다시 배포) ---

# Supabase API URL (SUPABASE_URL 과 같은 값)
NEXT_PUBLIC_SUPABASE_URL=
# anon(공개) 키 또는 sb_publishable_ 키. service_role / sb_secret_ 키를 넣으면 안 된다
NEXT_PUBLIC_SUPABASE_ANON_KEY=
